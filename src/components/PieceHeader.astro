---
/* The first screen of a case study: its image, its title, and where and
   when. Nothing else -- the image is the opening. The summary (the
   one-sentence label and the facts) is on the piece's card, which Home
   opens (WorkTiles.astro). The way back and around is the menu's; the
   way on is at the end of the story (NextPiece). Everything comes from
   src/data/pieces.ts. */
import PieceImage from './PieceImage.astro';
import { piece } from '../data/pieces';

interface Props { slug: string; readingTime?: boolean; }
const { slug, readingTime = false } = Astro.props;
const p = piece(slug);
---
<header class="piece">
  <figure>
    <PieceImage src={p.hero} alt="" eager />
  </figure>

  <hgroup>
    <h1>{p.title}</h1>
    <p>{p.client} · {p.years}{readingTime && <small><span id="reading-time"></span> min read</small>}</p>
  </hgroup>
</header>
