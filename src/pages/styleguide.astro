---
import Layout from '../layouts/Layout.astro';
import Icon from '../components/Icon.astro';
import { icons, angular } from '../data/icons';

// Rendered with the site's real CSS: every specimen below is plain markup in
// the same context it has on a content page. Use the mode button in the header to see
// each scheme; the roles re-derive live.

const roles = [
  ['text-primary', 'Headings, nav, footer'],
  ['text-secondary', 'Body and lead text'],
  ['text-tertiary', 'Captions, eyebrows, quote bar'],
  ['link', 'Accent text: hovered links, current page'],
  ['mark', 'Accent shapes: underlines, dividers, end mark, focus'],
  ['link-hover', 'Link hover'],
  ['fill-subtle', 'Hover, chat bubble, image placeholder'],
  ['fill-strong', 'Chosen option, tile placeholder'],
  ['border-subtle', 'Hairlines'],
  ['selection-bg', 'Text selection'],
  ['bg-action', 'The primary button'],
  ['bg-tooltip', 'Tooltips, in either scheme'],
  ['status-information', 'Message icon: information'],
  ['status-success', 'Message icon: success'],
  ['status-warning', 'Message icon: important'],
  ['status-danger', 'Message icon: danger; an invalid field'],
];
const rungs = ['50', '100', '200', '300', '400', '500', '600', '700', '800', '900', '950'];
const neutralRungs = ['50', '75', ...rungs.slice(1, -1), '925', '950', '975', '1000'];
const space = ['1', '2', '3', '4', '6', '8', '12', '16', '24'];

// Controls.
const types = ['primary', 'outlined', 'ghost'];
const sizes = [['xs', '28'], ['sm', '32'], ['md', '36'], ['lg', '40']];
const messages = [
  ['info', 'information', 'Feedback stays in your browser for now.'],
  ['success', 'success', 'Your message was sent.'],
  ['important', 'important', 'The guide has almost reached today’s limit.'],
  ['danger', 'danger', 'The guide could not answer. Try again in a minute.'],
];
---

<Layout
  title="Styleguide - Cristian Serrano"
  description="Every token and text style of cristianserrano.ar, rendered with the site's own CSS."
  noindex={true}
>
  <header>
    <hgroup>
      <h1>Styleguide</h1>
      <p>Display · Subtitle<br><small>Every token and text style, rendered with the site's own CSS.</small></p>
    </hgroup>
    <p>This paragraph is a lead: any paragraph directly in the page header, or in an overview, reads this way. Switch the mode in the header to see every value below re-derive.</p>
  </header>

  <section>
    <h2>Text styles</h2>
    <p>Each specimen is the real element in its real context. The caption names the text style, the markup that gets it, and its size / leading / weight in px.</p>

    <figure class="sg-specimen">
      <h2>Title for a section</h2>
      <figcaption>title — h2 · 32 / 1.4 / 600</figcaption>
    </figure>
    <figure class="sg-specimen">
      <h3>Heading for a sub-section <small>Dec 2024 – Present</small></h3>
      <figcaption>heading — h3, dt · 22 / 1.4 / 500 &nbsp;+&nbsp; meta — h3 small · 18 / 1.4 / 295</figcaption>
    </figure>
    <figure class="sg-specimen">
      <h4>Subheading <small>Munich, Germany</small></h4>
      <figcaption>subheading — h4 · 18 / 1.4 / 500 &nbsp;+&nbsp; meta-small — h4 small · 16 / 1.4 / 330</figcaption>
    </figure>
    <figure class="sg-specimen">
      <div class="overview"><p>A lead paragraph opens a story. It is larger and lighter than body text, so it reads as an introduction.</p></div>
      <figcaption>lead — header &gt; p, .overview p · 18 / 1.6 / 295</figcaption>
    </figure>
    <figure class="sg-specimen">
      <p>Body text carries the story. It has <b>bold emphasis</b>, <i>italics</i> and <a href="/styleguide/">links</a>, and is set for long reading.</p>
      <figcaption>body — p, li, dd · 16 / 1.6 / 330</figcaption>
    </figure>
    <figure class="sg-specimen">
      <ul>
        <li>A bulleted list item</li>
        <li>Another list item</li>
      </ul>
      <ol>
        <li>A numbered list item</li>
        <li>Another numbered item</li>
      </ol>
      <ul class="emoji-list">
        <li><span class="emoji-start" role="img" aria-label="compass">🧭</span><b>Emoji list:</b> items marked by a leading emoji</li>
      </ul>
      <figcaption>lists — ul, ol, ul.emoji-list · body</figcaption>
    </figure>
    <figure class="sg-specimen">
      <blockquote>
        <p>A quotation, set apart by a bar in the tertiary text colour.</p>
      </blockquote>
      <figcaption>quote — blockquote · body, italic</figcaption>
    </figure>
    <figure class="sg-specimen">
      <p class="note"><i>A note: small print that qualifies the paragraph above it.</i></p>
      <figcaption>caption — figcaption, p.note, footer p, the guide's disclaimer · 13 / 1.4 / 300</figcaption>
    </figure>
    <figure class="sg-specimen">
      <dl class="facts">
        <div><dt>Time</dt><dd>1 year, 7 months</dd></div>
        <div><dt>Platforms</dt><dd>Web, iOS, Android</dd></div>
        <div><dt>Category</dt><dd>Design systems</dd></div>
      </dl>
      <figcaption>key facts — dl.facts · label: overline, 13 / 1.4 / 700 · value: meta-small, 16 / 1.4 / 330</figcaption>
    </figure>
  </section>

  <hr>

  <section>
    <h2>Colour roles</h2>
    <p>What each colour is for. These are the only colours a rule may use.</p>
    <ul class="sg-swatches">
      {roles.map(([token, use]) => (
        <li><span class="sg-swatch" data-token={token}></span><b>{token}</b><br>{use}</li>
      ))}
    </ul>

    <h3>Accent ramp</h3>
    <p>Owned by the accent collection. The site uses blue; the tokens hold seven more.</p>
    <ul class="sg-ramp">
      {rungs.map((r) => <li><span class="sg-swatch" data-token={`accent-${r}`}></span>{r}</li>)}
    </ul>

    <h3>Neutral ramp</h3>
    <p>Owned by the temperature collection: warm, neutral or cold, whatever the accent. The site uses cold.</p>
    <ul class="sg-ramp">
      {neutralRungs.map((r) => <li><span class="sg-swatch" data-token={`neutral-${r}`}></span>{r}</li>)}
    </ul>
  </section>

  <section>
    <h2>Depth</h2>
    <p>Every background is one of four levels, back to front. In light mode depth reads from the shadows; in dark mode each level also steps lighter, the darkest at the back. A modal belongs to one panel: its backdrop is the canvas colour, blurred, and covers only that panel.</p>
    <div class="sg-depth" data-level="canvas">
      <b>canvas</b> behind the panels
      <div data-level="surface">
        <b>surface</b> a panel: the page, the guide
        <div data-level="raised">
          <b>raised</b> a card in a panel
          <div data-level="overlay"><b>overlay</b> a modal, a pop-up</div>
        </div>
      </div>
    </div>
  </section>

  <section>
    <h2>Space</h2>
    <p>One scale, named in multiples of 4px. Named values: <b>gutter</b> (space-8), <b>text-gap</b> (0.5em), <b>paragraph-gap</b> (1em).</p>
    <ul class="sg-space">
      {space.map((s) => <li><span class="sg-bar" data-step={s}></span>space-{s}</li>)}
    </ul>
  </section>

  <section>
    <h2>Shape and elevation</h2>
    <ul class="sg-shapes">
      <li><span class="sg-shape" data-shape="radius-md"></span>radius-md</li>
      <li><span class="sg-shape" data-shape="radius-lg"></span>radius-lg</li>
      <li><span class="sg-shape" data-shape="shadow-sm"></span>shadow-sm</li>
      <li><span class="sg-shape" data-shape="shadow-md"></span>shadow-md</li>
      <li><span class="sg-shape" data-shape="shadow-lg"></span>shadow-lg</li>
    </ul>
  </section>

  <hr>

  <section>
    <h2>Controls</h2>
    <p>Everything the visitor presses, types into or is told. One set of sizes, one set of states, one focus ring; the colours follow the mode.</p>

    <h3>Sizes and states</h3>
    <p>Every control is 32px tall unless a size says otherwise. Hover and pressed are drawn over whatever fill the control has; a disabled control is the same control at 40%; one focus ring serves everything.</p>
    <ul class="sg-shapes">
      <li><span class="sg-shape" data-shape="state-hovered"></span>state-hovered</li>
      <li><span class="sg-shape" data-shape="state-pressed"></span>state-pressed</li>
      <li><span class="sg-shape" data-shape="state-hovered-tint"></span>state-hovered-tint</li>
      <li><span class="sg-shape" data-shape="state-pressed-tint"></span>state-pressed-tint</li>
      <li><span class="sg-shape" data-shape="fill-input"></span>fill-input</li>
      <li><span class="sg-shape" data-shape="border-default"></span>border-default</li>
      <li><span class="sg-shape" data-shape="focus"></span>focus ring · 2px, 2px away</li>
      <li><span class="sg-shape" data-shape="disabled"></span>disabled · 40%</li>
    </ul>

    <h3>Icons</h3>
    <figure class="sg-specimen">
      <ul class="sg-icons">
        {Object.keys(icons).map((name) => (
          <li><Icon name={name} /><Icon name={name} filled />{name}</li>
        ))}
      </ul>
      <figcaption>Icon — 24-unit drawings shown at 16px, each in outline and filled; the filled one shows while its control is chosen or on. Arrows and chevrons have angular ends: {Object.keys(icons).filter(angular).join(', ')}. Icons: <a href="https://icon-sets.iconify.design/solar/">Solar</a> by 480 Design, <a href="https://creativecommons.org/licenses/by/4.0/">CC BY 4.0</a>. The diamond and the guide's star are the site's own.</figcaption>
    </figure>

    <h3>Button</h3>
    <figure class="sg-specimen">
      <div class="sg-row">
        {types.map((t) => (
          <button type="button" class="button" data-type={t}><span>{t[0].toUpperCase() + t.slice(1)}</span></button>
        ))}
        {types.map((t) => (
          <button type="button" class="button" data-type={t}>
            <Icon name="add" />
            <span>Add</span>
          </button>
        ))}
      </div>
      <figcaption>data-type — primary (default) · outlined · ghost. The label sits in a span; an icon goes before or after it.</figcaption>
    </figure>
    <figure class="sg-specimen">
      <div class="sg-row">
        {sizes.map(([s, px]) => (
          <button type="button" class="button" data-type="outlined" data-size={s}><span>{s} · {px}</span></button>
        ))}
        {sizes.map(([s]) => (
          <button type="button" class="button" data-type="outlined" data-size={s} data-has-text="false" data-tooltip="top" aria-label={`Close (${s})`}>
            <Icon name="close" />
          </button>
        ))}
      </div>
      <figcaption>data-size — xs · sm (default) · md · lg. With data-has-text="false" the button is a square and its aria-label becomes its tooltip: hover one, or reach it with Tab.</figcaption>
    </figure>
    <figure class="sg-specimen">
      <div class="sg-row">
        {types.map((t) => (
          <button type="button" class="button" data-type={t} disabled><span>Disabled</span></button>
        ))}
      </div>
      <figcaption>disabled — the native attribute, any type: the same button at 40%.</figcaption>
    </figure>
    <figure class="sg-specimen">
      <div class="sg-row">
        <button type="button" class="button" data-type="ghost" data-has-text="false" data-tooltip="top" aria-pressed="true" aria-label="Helpful">
          <Icon name="like" twin />
        </button>
        <button type="button" class="button" data-type="ghost" data-has-text="false" data-tooltip="top" aria-pressed="false" aria-label="Not pressed">
          <Icon name="like" twin />
        </button>
        <button type="button" class="button" data-type="outlined">
          <span>Options</span>
          <Icon name="chevron-down" />
        </button>
      </div>
      <figcaption>on — aria-pressed="true" or aria-expanded="true" on a ghost button: a toggle, or a button whose panel is open. An icon-only one fills its icon. Last: a trailing icon.</figcaption>
    </figure>

    <h3>Chip</h3>
    <figure class="sg-specimen">
      <ul class="chips">
        <li><button type="button" class="chip" aria-pressed="true">Accurate</button></li>
        <li><button type="button" class="chip" aria-pressed="false">Clear</button></li>
        <li><button type="button" class="chip" aria-pressed="false">Quick</button></li>
        <li><button type="button" class="chip" aria-pressed="true">Something else</button></li>
      </ul>
      <figcaption>.chip — an option to pick, any number of them; aria-pressed="true" when picked. Flat, with the menu's chosen look. Used for the reasons in the guide's feedback dialog.</figcaption>
    </figure>

    <h3>Segmented control</h3>
    <figure class="sg-specimen">
      <div class="sg-stack">
        <div class="segmented sg-narrow" role="group" aria-label="Example">
          <button type="button" aria-pressed="false">System</button>
          <button type="button" aria-pressed="true">Light</button>
          <button type="button" aria-pressed="false">Dark</button>
        </div>
      </div>
      <figcaption>.segmented — a 32px track of 28px items; the chosen one has aria-pressed="true". Not used on the site at present.</figcaption>
    </figure>

    <h3>Field</h3>
    <figure class="sg-specimen">
      <div class="sg-stack sg-narrow">
        <input class="field" type="text" aria-label="Subtle" placeholder="subtle (default)">
        <input class="field" type="text" data-background="opaque" aria-label="Opaque" placeholder="opaque">
        <input class="field" type="text" data-background="transparent" aria-label="Transparent" placeholder="transparent">
        <input class="field" type="text" aria-invalid="true" aria-label="Invalid" value="aria-invalid">
        <input class="field" type="text" aria-label="Disabled" placeholder="disabled" disabled>
        <textarea class="field" rows="3" aria-label="Several lines" placeholder="A textarea is the same field"></textarea>
      </div>
      <figcaption>.field — input or textarea · data-background: subtle (default) · opaque · transparent · aria-invalid="true". Used in the guide's feedback dialog.</figcaption>
    </figure>
    <figure class="sg-specimen">
      <div class="sg-stack sg-narrow">
        <div class="form-item">
          <label for="sg-name">Name</label>
          <input class="field" id="sg-name" type="text" aria-describedby="sg-name-hint">
          <p id="sg-name-hint">A hint sits under the field.</p>
        </div>
        <div class="form-item">
          <label for="sg-company">Company <small>- Optional</small></label>
          <input class="field" id="sg-company" type="text">
        </div>
        <div class="form-item">
          <label for="sg-email">Email</label>
          <input class="field" id="sg-email" type="email" value="name@" aria-invalid="true" aria-describedby="sg-email-hint">
          <p id="sg-email-hint">Enter a full email address, like name@example.com.</p>
        </div>
      </div>
      <figcaption>.form-item — label · the field · a hint. The label is 12 / 16 / 500, the hint 12 / 16 / 400, 4px apart. An error is said in the hint. Not used on the site yet.</figcaption>
    </figure>

    <h3>Checkbox</h3>
    <figure class="sg-specimen">
      <div class="sg-stack">
        <label class="checkbox"><input type="checkbox"><span>Unchecked</span></label>
        <label class="checkbox"><input type="checkbox" checked><span>Checked</span></label>
        <label class="checkbox"><input type="checkbox" aria-checked="mixed"><span>Mixed: some, not all, of its items are selected</span></label>
        <label class="checkbox"><input type="checkbox" data-background="opaque"><span>Opaque background</span></label>
        <label class="checkbox"><input type="checkbox" aria-invalid="true"><span>Invalid</span></label>
        <label class="checkbox"><input type="checkbox" disabled><span>Disabled</span></label>
        <label class="checkbox"><input type="checkbox" checked disabled><span>Disabled, checked</span></label>
        <label class="checkbox sg-narrow"><input type="checkbox" checked><span>Long text wraps beside the box, and the box stays on the first line.</span></label>
      </div>
      <figcaption>.checkbox — a label around the native input and its text. An 18px box in a 20px space, the text 8px away. data-background: subtle (default) · opaque. Not used on the site yet.</figcaption>
    </figure>

    <h3>Radio</h3>
    <figure class="sg-specimen">
      <div class="sg-stack" role="radiogroup" aria-label="Example">
        <label class="radio"><input type="radio" name="sg-radio" checked><span>Chosen</span></label>
        <label class="radio"><input type="radio" name="sg-radio"><span>Not chosen</span></label>
        <label class="radio"><input type="radio" name="sg-radio" data-background="opaque"><span>Opaque background</span></label>
        <label class="radio"><input type="radio" name="sg-radio" aria-invalid="true"><span>Invalid</span></label>
        <label class="radio"><input type="radio" name="sg-radio-off" disabled><span>Disabled</span></label>
        <label class="radio"><input type="radio" name="sg-radio-on" checked disabled><span>Disabled, chosen</span></label>
      </div>
      <figcaption>.radio — a label around the native input and its text. The checkbox's edge, fills and states as a 20px circle with an 8px dot: 2px larger than the checkbox, because round reads smaller than square. Not used on the site yet.</figcaption>
    </figure>

    <h3>Switch</h3>
    <figure class="sg-specimen">
      <div class="sg-stack">
        <label class="switch"><input type="checkbox" role="switch"><span>Off</span></label>
        <label class="switch"><input type="checkbox" role="switch" checked><span>On</span></label>
        <label class="switch"><input type="checkbox" role="switch" data-background="opaque"><span>Opaque background</span></label>
        <label class="switch"><input type="checkbox" role="switch" disabled><span>Disabled</span></label>
        <label class="switch"><input type="checkbox" role="switch" checked disabled><span>Disabled, on</span></label>
      </div>
      <figcaption>.switch — a native checkbox with role="switch". The checkbox's 20px height, edge, fills and states; a 30 × 18px track and a 14px thumb that travels 12px. Not used on the site yet.</figcaption>
    </figure>

    <h3>Message</h3>
    <figure class="sg-specimen">
      <div class="sg-stack">
        {messages.map(([icon, type, text]) => (
          <div class="message" data-type={type}>
            <Icon name={icon} filled />
            <div><strong>{type[0].toUpperCase() + type.slice(1)}</strong><p>{text}</p></div>
          </div>
        ))}
      </div>
      <figcaption>.message — data-type: information (default) · success · important · danger. On a real page: role="status" for the first two, role="alert" for the others. The title is optional. Used in the guide's feedback dialog.</figcaption>
    </figure>

    <h3>Code</h3>
    <figure class="sg-specimen">
      <p>A name or a value inside a sentence, such as <code>--space-4</code> or <code>data-type="ghost"</code>, is inline code.</p>
      <pre><code>:focus-visible &#123;
  outline: var(--border-accent) solid var(--mark);
  outline-offset: var(--focus-offset);
&#125;</code></pre>
      <figcaption>code — code, pre &gt; code · 13 / 1.35 / 500, the system's monospace. Used in the guide's answers.</figcaption>
    </figure>
  </section>

  <p class="end-mark" aria-hidden="true">◼︎</p>
</Layout>
