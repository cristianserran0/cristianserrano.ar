---
/* The case study template: the original page from the live site
   (work/template/index.html on master), brought over as it was -- its
   order, its placeholders and its filler text -- in this site's markup.
   A place to iterate on the case study design; not a real page: hidden
   from search engines and left out of the sitemap (astro.config.mjs).

   Its order: title, client · year and reading time, the image, the
   summary, the facts, then the story in sections.

   Its menu is a case study's: Back, the page's name, its sections
   (`sections`, Layout.astro).

   Not brought over: the old page's own menu and footer (the layout has
   the site's), and its row of links to other work at the end. */
import Layout from '../layouts/Layout.astro';
import { Image } from 'astro:assets';
import placeholder from '../assets/work/template/openbank-cover.png';
---

<Layout
  title="{Project title} - Cristian Serrano"
  description="The case study template."
  readingTime={true}
  noindex={true}
  sections={true}
>
  <header>
    <hgroup>
      <h1>{'{Project title}'}</h1>
      <p>{'{COMPANY/CLIENT} · {year}'}<br><small><span id="reading-time"></span> mins. read</small></p>
    </hgroup>
    <figure class="wide">
      <Image src={placeholder} alt="" loading="eager" decoding="async" />
    </figure>
  </header>

  <section id="summary">
    <article class="overview">
      <p>{'{Summary}'}</p>
    </article>
  </section>

  <dl class="facts">
    <div><dt>Category</dt><dd>{'{categories}'}</dd></div>
    <div><dt>Platforms</dt><dd>{'{platforms}'}</dd></div>
    <div><dt>Role</dt><dd>{'{roles}'}</dd></div>
    <div><dt>Time</dt><dd>{'{time}'}</dd></div>
  </dl>

  <hr>

