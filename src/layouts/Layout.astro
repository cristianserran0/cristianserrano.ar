---
import '../styles/index.css';
import PieceHeader from '../components/PieceHeader.astro';
import NextPiece from '../components/NextPiece.astro';
import { piece as getPiece, nextPiece, featured, href, aboutCristian } from '../data/pieces';
import { getImage } from 'astro:assets';
import ogDefault from '../assets/og/default.png';

interface Props {
  title: string;
  description: string;
  readingTime?: boolean;
  noindex?: boolean;
  /* On a case study: its slug in src/data/pieces.ts. The layout then draws
     the piece's first screen and the "next piece" at the end of the story. */
  piece?: string;
}

const pathname = Astro.url.pathname;
const { title, description, readingTime = false, noindex = false, piece } = Astro.props;
const current = piece ? getPiece(piece) : undefined;
const next = piece ? nextPiece(piece) : undefined;

// accent modes offered to visitors; must match [accent="..."] in styles/tokens/color.css
const accents = ['blue', 'purple', 'magenta', 'red', 'orange', 'green', 'emerald', 'sky'];

/* The pages of the site besides Home. The work has no page of its own:
   it is the home page. */
const nav = [
  { href: '/cv/',   label: 'CV',   current: pathname.startsWith('/cv') },
  { href: '/about/', label: 'About', current: pathname.startsWith('/about') },
  { href: '/contact/', label: 'Contact', current: pathname.startsWith('/contact') },
];

/* The menu: the pages of the site, each with a 16px icon
   in two drawings: `icon` in outline, and `filled` for the chosen page
   (where a plain fill of the outline would swallow its inner lines). */
const menu = [
  { href: '/', label: 'Home', current: pathname === '/', icon: 'M2.5 7.5 8 3l5.5 4.5V13h-4V9.5h-3V13h-4z',
    filled: 'M2.5 7.5 8 3l5.5 4.5V13h-4V9.5h-3V13h-4z' },
  { href: '/cv/', label: 'CV', current: pathname.startsWith('/cv'), icon: 'M4 2h5.5l3 3v9H4zM9.5 2v3h3M6.25 8.25h3.5M6.25 10.75h3.5',
    filled: 'M4 2h5.5l3 3v9H4zM5.6 7.1h4.8v2H5.6zM5.6 10.1h4.8v2H5.6z' },
  { href: '/about/', label: 'About', current: pathname.startsWith('/about'), icon: 'M8 7.25a2.5 2.5 0 1 0 0-5 2.5 2.5 0 0 0 0 5zM3 14c.4-2.8 2.4-4.25 5-4.25s4.6 1.45 5 4.25',
    filled: 'M8 7.25a2.5 2.5 0 1 0 0-5 2.5 2.5 0 0 0 0 5zM3 14c.4-2.8 2.4-4.25 5-4.25s4.6 1.45 5 4.25z' },
  { href: '/contact/', label: 'Contact', current: pathname.startsWith('/contact'), icon: 'M2 4h12v8.5H2zM2.25 4.5 8 9l5.75-4.5',
    filled: 'M2.5 3.75h11L8 7.9zM2 6.1 8 10.6l6-4.5v6.4H2z' },
];

/* What the guide needs to know about the room the visitor is in, and the
   featured pieces for its tours. Data, not code: a JSON block the CSP allows. */
const room = current
  ? { kind: 'piece', slug: current.slug, title: current.title, client: current.client, years: current.years,
      label: aboutCristian(current.label), facts: current.facts,
      next: next && { title: next.title, href: href(next) } }
  : pathname.startsWith('/cv') ? { kind: 'cv' }
  : pathname.startsWith('/contact') ? { kind: 'contact' }
  : pathname === '/' ? { kind: 'home' }
  : { kind: 'other' };
const guide = {
  room,
  pieces: featured.map((p) => ({ slug: p.slug, title: p.title, client: p.client, years: p.years, label: aboutCristian(p.label), role: p.facts.role, category: p.facts.category, href: href(p) })),
};

/* ---- search and sharing ----
   One address per page, from the site's real address (astro.config.mjs
   site), never www. -- that redirects, and a canonical that redirects is a
   conflicting signal. */
const SITE = Astro.site!;
const url = new URL(pathname, SITE).href;
const abs = (path: string) => new URL(path, SITE).href;

// The sharing image: a case study's own cover, cropped to 1200 x 630 at
// build time; otherwise a real screenshot of the site (assets/og/default).
const ogSource = current && typeof current.hero !== 'string' ? current.hero : ogDefault;
const og = await getImage({ src: ogSource, width: 1200, height: 630, fit: 'cover', position: 'top', format: 'jpg', quality: 82 });
const ogImage = abs(og.src);

/* Structured data: one connected graph, so search engines and AI systems
   read "a case study by Cristian Serrano, for <client>, <years>" as facts
   rather than guessing from the text. */
const PERSON = abs('/#person');
const WEBSITE = abs('/#website');
const years = current ? (current.years.match(/\d{4}/g) || []) : [];
const temporal = current
  ? (/present/i.test(current.years) ? `${years[0]}/..` : years.length > 1 ? `${years[0]}/${years[years.length - 1]}` : years[0])
  : undefined;
const crumbs = [{ name: 'Home', path: '/' }]
  .concat(pathname !== '/' ? [{
    name: current ? current.title
      : (nav.find((n) => n.href === pathname) || { label: title.split(' - ')[0] }).label,
    path: pathname,
  }] : []);
const jsonLd = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'Person',
      '@id': PERSON,
      name: 'Cristian Serrano',
      jobTitle: 'Head of Design',
      worksFor: { '@type': 'Organization', name: 'JustRelate', url: 'https://www.justrelate.com' },
      url: abs('/'),
      sameAs: ['https://www.linkedin.com/in/cristianserrano'],
      address: { '@type': 'PostalAddress', addressLocality: 'Munich', addressCountry: 'DE' },
      knowsLanguage: ['en', 'de', 'es'],
      knowsAbout: ['Product Design', 'Design Systems', 'Design Operations', 'Design Leadership', 'UX Design', 'AI Product Design', 'SaaS'],
      description: 'Cristian Serrano is a Senior Product Designer and Design Systems specialist with 17+ years of experience, based in Munich, Germany. Currently Head of Design at JustRelate.',
    },
    { '@type': 'WebSite', '@id': WEBSITE, url: abs('/'), name: 'Cristian Serrano', inLanguage: 'en', publisher: { '@id': PERSON } },
    {
      '@type': pathname.startsWith('/about') ? 'ProfilePage' : 'WebPage',
      '@id': url + '#page',
      url, name: title, description, inLanguage: 'en',
      isPartOf: { '@id': WEBSITE },
      primaryImageOfPage: ogImage,
      breadcrumb: { '@id': url + '#breadcrumb' },
      ...(pathname.startsWith('/about') ? { mainEntity: { '@id': PERSON } } : {}),
      ...(current ? { mainEntity: { '@id': url + '#work' } } : {}),
    },
    {
      '@type': 'BreadcrumbList',
      '@id': url + '#breadcrumb',
      itemListElement: crumbs.map((c, i) => ({ '@type': 'ListItem', position: i + 1, name: c.name, item: abs(c.path) })),
    },
    ...(current ? [{
      '@type': 'CreativeWork',
      '@id': url + '#work',
      name: current.title,
      abstract: aboutCristian(current.label),
      creator: { '@id': PERSON },
      about: current.client.split(' + ').map((name) => ({ '@type': 'Organization', name })),
      ...(temporal ? { temporalCoverage: temporal } : {}),
      keywords: current.facts.category.replace(/\.$/, ''),
      description: `${aboutCristian(current.label)} Role: ${current.facts.role}. Platforms: ${current.facts.platforms}. Time: ${current.facts.time}.`,
      image: ogImage,
      url,
      inLanguage: 'en',
    }] : []),
  ],
};
---

<!DOCTYPE html>
<html lang="en" temperature="cold" accent="blue">
  <head>
    <!-- Preconnect hints -->
    <link rel="preconnect" href="https://www.googletagmanager.com">
    <link rel="preconnect" href="https://www.google-analytics.com">
    <link rel="preconnect" href="https://code.etracker.com">

    <!-- Google Analytics -->
    <script async src="https://www.googletagmanager.com/gtag/js?id=G-02JHYJG539" is:inline></script>
    <script defer is:inline src="/js/analytics.js"></script>
    <!-- etracker -->
    <script id="_etLoader" type="text/javascript" charset="UTF-8" data-block-cookies="true" data-secure-code="L9bc0V" src="https://code.etracker.com/code/e.js" async is:inline></script>

    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <title>{title}</title>
    <meta name="description" content={description}>
    {noindex && <meta name="robots" content="noindex">}
    <link rel="canonical" href={url}>

    <!-- Open Graph / social sharing -->
    <meta property="og:type" content={current ? 'article' : 'website'}>
    <meta property="og:url" content={url}>
    <meta property="og:title" content={title}>
    <meta property="og:description" content={description}>
    <meta property="og:image" content={ogImage}>
    <meta property="og:image:width" content="1200">
    <meta property="og:image:height" content="630">
    <meta property="og:image:alt" content={current ? current.alt : 'Cristian Serrano, digital product designer'}>
    <meta property="og:site_name" content="Cristian Serrano">
    <meta property="og:locale" content="en">
    <meta name="twitter:card" content="summary_large_image">
    <meta name="twitter:title" content={title}>
    <meta name="twitter:description" content={description}>
    <meta name="twitter:image" content={ogImage}>

    <!-- Structured data -->
    <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />

    <!-- Resolve the stored appearance before first paint, so there is no flash.
         "system" stores nothing and sets no attribute: :root carries
         color-scheme: light dark, so the OS is followed natively and live. -->
    <script is:inline src="/js/appearance-init.js"></script>

    <!-- The upright Inter faces, asked for at once rather than after the
         styles are read, so they are usually in place for the first paint
         (see styles/tokens/type.css). -->
    {['Light', 'Regular', 'Medium', 'SemiBold', 'Bold'].map((face) => (
      <link rel="preload" href={`/fonts/inter/Inter-${face}.woff2`} as="font" type="font/woff2" crossorigin />
    ))}
    <link rel="icon" type="image/png" href="/favicon.png" sizes="16x16 32x32">
    <script type="application/json" id="guide-data" set:html={JSON.stringify(guide)} />
    <!-- Hold the first paint until the guide is rebuilt (see the end of the
         page), so a page change never shows it half-built. -->
    <link rel="expect" href="#guide-ready" blocking="render">
    <script defer is:inline src="/js/header-behaviour.js"></script>
    <script defer is:inline src="/js/seniority.js"></script>
    {readingTime && <script defer is:inline src="/js/reading-time-estimation.js"></script>}
    <script defer is:inline src="/js/current-year.js"></script>
    <script defer is:inline src="/js/appearance.js"></script>
    <script defer is:inline src="/js/tooltip.js"></script>
    <script defer is:inline src="/js/side-nav.js"></script>
  </head>

  <body>
    <!-- First stop for keyboard and screen-reader users: past the header,
         straight to the page's content. Hidden until it has focus. -->
    <a class="skip-link" href="#content">Skip to content</a>
    <!-- tabindex -1: focusable by script, not in the Tab order; see
         header-behaviour.js (keyboard scrolling of the panel). -->
    <div class="page" tabindex="-1">

      <header class="site-header nav-visible">
        <nav class="site-nav" aria-label="Site">
          {/* The top bar (when the menu has no space of its own): a mark,
              then the menu. Home: the diamond, the pages inline where
              they fit, a drop-down on phones. A case study: Back, and
              a drop-down of its sections, labelled with the one in view. */}
          {current
            ? <a class="button" data-type="ghost" data-has-text="false" data-tooltip="start" href="/" aria-label="Back">
                <svg viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M13 8H3M7 4 3 8l4 4"/></svg>
              </a>
            : <a class="site-mark" href="/" aria-label="Cristian Serrano, home"></a>}
          {!current && (
            <ul class="site-links">
              {nav.map((item) => (
                <li><a href={item.href} aria-current={item.current ? 'page' : undefined}>{item.label}</a></li>
              ))}
            </ul>
          )}
          <button type="button" class="menu-trigger" popovertarget="page-menu" data-kind={current ? 'index' : 'pages'}>
            <span data-menu-current>{current ? current.title : (menu.find((item) => item.current) || menu[0]).label}</span>
            <svg viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M4 6l4 4 4-4"/></svg>
          </button>

          <div class="site-actions">
            <button type="button" class="button" data-type="ghost" data-has-text="false" data-tooltip="end" popovertarget="display" aria-label="Display">
              <svg viewBox="0 0 16 16" aria-hidden="true"><circle cx="8" cy="8" r="6.25" fill="none" stroke="currentColor" stroke-width="1.5"/><path d="M8 1.75a6.25 6.25 0 0 1 0 12.5z" fill="currentColor"/></svg>
            </button>
            <button type="button" class="button" data-type="ghost" data-has-text="false" data-tooltip="end" data-assistant-toggle aria-controls="assistant" aria-expanded="false" aria-label="Guide">
              <svg viewBox="0 0 16 16" aria-hidden="true" fill="none" stroke="currentColor" stroke-width="1.4" stroke-linejoin="round"><path d="M8 2.25Q9.5 6.5 13.75 8 9.5 9.5 8 13.75 6.5 9.5 2.25 8 6.5 6.5 8 2.25Z"/></svg>
            </button>
          </div>
        </nav>

        <div class="page-menu" id="page-menu" popover>
          {current
            ? <ul class="menu" data-page-index></ul>
            : <ul class="menu">
                {menu.map((item) => (
                  <li>
                    <a class="menu-item" href={item.href} aria-current={item.current ? 'page' : undefined}>
                      <svg viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.4" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path class="icon-outline" d={item.icon}/><path class="icon-filled" fill-rule="evenodd" d={item.filled}/></svg>
                      <span>{item.label}</span>
                    </a>
                  </li>
                ))}
              </ul>}
        </div>

        <div class="display" id="display" popover>
          <p id="display-scheme">Mode</p>
          <div class="segmented" role="group" aria-labelledby="display-scheme">
            <button type="button" data-scheme="system">System</button>
            <button type="button" data-scheme="light">Light</button>
            <button type="button" data-scheme="dark">Dark</button>
          </div>
          <p id="display-temperature">Temperature</p>
          <div class="segmented" role="group" aria-labelledby="display-temperature">
            <button type="button" data-temperature="warm">Warm</button>
            <button type="button" data-temperature="neutral">Neutral</button>
            <button type="button" data-temperature="cold">Cold</button>
          </div>
          <p id="display-accent">Accent</p>
          <div class="accents" role="group" aria-labelledby="display-accent">
            {accents.map((name) => (
              <button
                type="button"
                class="accent-swatch"
                data-accent={name}
                accent={name}
                aria-label={name}
                title={name}
              />
            ))}
          </div>
        </div>
      </header>

      <div class="page-frame">
        <nav class="side-nav" aria-label={current ? 'On this page' : 'Menu'}>
          <div>
            {current ? (
              <>
                <a class="button" data-type="ghost" data-has-text="false" data-tooltip="start" href="/" aria-label="Back">
                  <svg viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M13 8H3M7 4 3 8l4 4"/></svg>
                </a>
                <ul class="menu" data-page-index></ul>
              </>
            ) : (
              <>
                <a class="site-mark" href="/" aria-label="Cristian Serrano, home"></a>
                <ul class="menu">
                  {menu.map((item) => (
                    <li>
                      <a class="menu-item" href={item.href} aria-current={item.current ? 'page' : undefined}>
                        <svg viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.4" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path class="icon-outline" d={item.icon}/><path class="icon-filled" fill-rule="evenodd" d={item.filled}/></svg>
                        <span>{item.label}</span>
                      </a>
                    </li>
                  ))}
                </ul>
              </>
            )}
          </div>
        </nav>
      <div class="page-body">
        <main class="prose" id="content" tabindex="-1">
          {piece && <PieceHeader slug={piece} readingTime={readingTime} />}
          <slot />
          {piece && <NextPiece slug={piece} />}
        </main>

        <footer class="site-footer">
          <p>Handcrafted with <span class="love">♥</span> en La Plata <span class="emoji" role="img" aria-label="argentina">🇦🇷</span> und München <span class="emoji" role="img" aria-label="deutschland">🇩🇪</span>.</p>
          <p>&copy;<span class="current-year"></span> Cristian Serrano</p>
        </footer>
      </div>
      </div>

    </div>

    <aside class="assistant" id="assistant" aria-label="Assistant">
      <header class="assistant-header">
        <h2>Guide</h2>
        <div class="assistant-actions">
          <button type="button" class="button" data-type="ghost" data-has-text="false" popovertarget="guide-menu" aria-label="More options">
            <svg viewBox="0 0 16 16" fill="currentColor" aria-hidden="true"><circle cx="3.5" cy="8" r="1.25"/><circle cx="8" cy="8" r="1.25"/><circle cx="12.5" cy="8" r="1.25"/></svg>
          </button>
          <!-- More options: the guide's text style and column, to compare
               them live (remembered; set on <html>, read by the tokens),
               and Clear chat. A native popover: no script to open,
               close or dismiss it. -->
          <div class="guide-menu" id="guide-menu" popover>
            <p id="guide-menu-type">Text style</p>
            <div role="group" aria-labelledby="guide-menu-type">
              <button type="button" data-guide-type="coworker"><span>Coworker</span><small>14 / 1.5 · regular</small></button>
              <button type="button" data-guide-type="light"><span>Light</span><small>14 / 1.5 · light</small></button>
              <button type="button" data-guide-type="page"><span>Like the page</span><small>16 / 1.6 · light</small></button>
            </div>
            <button type="button" data-guide-measure><span>Narrow column</span><small>600px instead of 720px</small></button>
            <hr>
            <button type="button" data-guide-keep><span>Keep this chat</span><small>for your next visit</small></button>
            <button type="button" data-assistant-clear disabled><span>Clear chat</span></button>
          </div>
          <button type="button" class="button" data-type="ghost" data-has-text="false" data-tooltip="end" data-assistant-close aria-label="Close guide">
            <svg viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" aria-hidden="true"><path d="M4 4l8 8M12 4l-8 8"/></svg>
          </button>
        </div>
      </header>

      <div class="assistant-thread">
        <!-- The blank state: until the first question, what the guide can do
             here, with suggestions that fit the page. Filled by assistant.js. -->
        <section class="assistant-empty" aria-labelledby="guide-empty-title" hidden>
          <span class="assistant-mark" aria-hidden="true"></span>
          <h3 id="guide-empty-title" data-empty-title></h3>
          <ul class="assistant-options" data-empty-options></ul>
        </section>
        <ol class="assistant-log" aria-live="polite"></ol>
        <button type="button" class="assistant-jump" data-tooltip="top" aria-label="Jump to latest" hidden>
          <svg viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M8 3v10M4 9l4 4 4-4"/></svg>
        </button>
      </div>

      <form class="assistant-composer">
        <textarea rows="2" aria-label="Message" placeholder="Ask about Cristian’s work, CV or this site…"></textarea>
        <div>
          <!-- Send; while an answer streams it becomes Stop, in the same place. -->
          <button type="submit" class="button" data-has-text="false" data-tooltip="end" aria-label="Send" disabled>
            <svg data-icon="send" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M8 13V3M4 7l4-4 4 4"/></svg>
            <svg data-icon="stop" viewBox="0 0 16 16" aria-hidden="true"><rect x="4" y="4" width="8" height="8" rx="1.5" fill="currentColor"/></svg>
          </button>
        </div>
      </form>
      <p class="assistant-disclaimer">AI can make mistakes. Check what matters.</p>

      <!-- Feedback on an answer. A modal of THIS panel only: its backdrop
           covers the guide, never the page. See styles/components/modal.css. -->
      <div class="panel-modal" data-feedback hidden>
        <dialog open aria-modal="true" aria-labelledby="feedback-title">
          <form>
            <h3 id="feedback-title" data-feedback-title>What went wrong?</h3>
            <ul class="chips feedback-reasons" data-feedback-reasons aria-label="Reasons"></ul>
            <textarea class="field" rows="3" aria-label="Anything to add? (optional)" placeholder="Anything to add? (optional)"></textarea>
            <div class="message" data-type="information" role="status">
              <svg viewBox="0 0 20 20" aria-hidden="true"><path fill="currentColor" fill-rule="evenodd" d="M10 1.75a8.25 8.25 0 1 0 0 16.5 8.25 8.25 0 0 0 0-16.5zM10 5a1.1 1.1 0 1 1 0 2.2A1.1 1.1 0 0 1 10 5zm-1 4h2v6H9z"/></svg>
              <div><p>Prototype: feedback stays in your browser for now.</p></div>
            </div>
            <div>
              <button type="button" class="button" data-type="outlined" data-feedback-cancel><span>Cancel</span></button>
              <button type="submit" class="button"><span>Send</span></button>
            </div>
          </form>
        </dialog>
      </div>
    </aside>

    <!-- The handle between the page and the guide: drag (or arrow keys)
         to resize the guide. Wide screens with the guide open only. -->
    <div class="panel-resizer" role="separator" aria-orientation="vertical"
         aria-label="Resize the guide" aria-controls="assistant" tabindex="0"></div>

    <!-- Not deferred: it runs here, before the first paint, so the guide is
         complete when the page appears. The marker after it releases the
         render block set in <head>. -->
    <script is:inline src="/js/guide-ai.js"></script>
    <script is:inline src="/js/assistant.js"></script>
    <span id="guide-ready" hidden></span>
  </body>
</html>
